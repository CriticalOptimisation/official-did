# Private keys never touch this repository: tools/make-did.mjs reads them from
# stdin and writes them to stdout only. These patterns are a second line of
# defence against a key saved by mistake.
*.private.jwk
*private*.json
*.pem
.env
node_modules/
/.worktrees/
# netlify-env-public/ holds the variables of each domain's Netlify project,
# public by design (#11): nothing but <domain>.env files directly in it, and
# no directory named like one.
/netlify-env-public/*
!/netlify-env-public/*.env
/netlify-env-public/.env
/netlify-env-public/*.env/
/dist/

# --- Change History -------------------------------------------------------
# | PR     | Summary                                                       |
# |--------|---------------------------------------------------------------|
# | #10    | ignore env/ and dist/ (#8)                                    |
# | #13    | netlify-env-public/ admits only <domain>.env files (#11)      |
